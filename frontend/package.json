{
  "name": "tax-help",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:rules": "node --experimental-loader ./tests/ts-loader.mjs lib/rules/__tests__/scenarios.test.ts",
    "test:unit": "node --experimental-loader ./tests/ts-loader.mjs --test tests/unit.test.ts",
    "test:e2e": "playwright test",
    "test": "npm run typecheck && npm run lint && npm run test:unit && npm run test:rules",
    "test:all": "npm test && npm run test:e2e"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "^4.33.0",
    "@google/genai": "^2.31.0",
    "lucide-react": "1.61.0",
    "next": "^16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "postcss": "8.5.31",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
