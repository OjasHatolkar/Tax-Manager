# Tax Help - environment variables (example only; no real secrets here)
#
HEAD
# Gemini is used by server-side API routes.
# Copy this file to .env.local and fill in the values. Never commit .env.local.

# --- Gemini API (server-side only) ---
# Get a key from Google AI Studio: https://aistudio.google.com/app/apikey
# Must NOT be prefixed with NEXT_PUBLIC_ - it should only ever be read on
# the server (e.g. in a Route Handler), never shipped to the browser bundle.
GEMINI_API_KEY=
GEMINI_API_MODEL=gemini-3.8-flash

# --- Auth0 (nextjs-auth0 v4) ---
# Values come from your Auth0 application settings: https://manage.auth0.com/
# AUTH0_DOMAIN is only the domain, e.g. your-tenant.us.auth0.com (no https://).
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000
