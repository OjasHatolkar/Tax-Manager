# Tax Help — environment variables (example only; no real secrets here)
#
# Gemini is used by server-side API routes. Auth0 remains a future feature.

# --- Gemini API (server-side only) ---
# Get a key from Google AI Studio: https://aistudio.google.com/app/apikey
# Must NOT be prefixed with NEXT_PUBLIC_ — it should only ever be read on
# the server (e.g. in a Route Handler or Server Action), never shipped to
# the browser bundle.
GEMINI_API_KEY=
GEMINI_API_MODEL=gemini-3.8-flash

# --- Auth0 (future sign-in / saved progress) ---
# Values come from your Auth0 application settings:
# https://manage.auth0.com/
AUTH0_SECRET=                 # openssl rand -hex 32
AUTH0_BASE_URL=http://localhost:3000
AUTH0_ISSUER_BASE_URL=https://YOUR_TENANT.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
